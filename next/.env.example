# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ── Storage ─────────────────────────────────────────────
DATABASE_PATH=./data/vanmanga.db
MANGA_BASE_PATH=./manga
LOG_PATH=./logs/app.log

# ── Auth ────────────────────────────────────────────────
# "token" (standalone) | "jwt" (external IdP)
AUTH_MODE=token

# token 模式：预设 Admin Token（不填则首次启动自动生成并打印）
# ADMIN_TOKEN=your_token_here

# jwt 模式：外部 IdP 配置
# JWT_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# JWT_SECRET=your_shared_secret        # HS256 时使用，与 JWKS_URL 二选一
# JWT_ALGORITHM=RS256
# JWT_ADMIN_CLAIM=role
# JWT_ADMIN_VALUE=admin
