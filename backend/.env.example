# Server
PORT=5000
NODE_ENV=development

# Frontend (passed through to /static/js/config.js)
MANGA_BASE_URL=http://localhost:5000
MANGA_BASE_WEBSOCKET_URL=http://localhost:5000

# Storage paths
DOWNLOAD_ROOT=./downloaded
LIBRARY_FILE=./eng_config/manga_library.json
THUMBNAILS_DIR=./thumbnails

# Concurrency
NUMBER_OF_WORKERS=2

# Redis (for Bull queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Kavita (optional)
KAVITA_BASE_URL=
KAVITA_EXPOSE_URL=
KAVITA_ADMIN_APIKEY=
KAVITA_LIB_ID=1

# FlareSolverr (optional)
FLARESOLVERR_URL=

# Python scraper subprocess (Plan A — wraps existing modules/*)
PYTHON_EXECUTABLE=python
PYTHON_CLI_SCRIPT=../scrape_cli.py
PYTHON_WORKING_DIR=..
PYTHON_TIMEOUT_MS=180000
