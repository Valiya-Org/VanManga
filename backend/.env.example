# Every variable is optional; the value shown is the default.
# Relative paths resolve against the backend's working directory.

# --- Server
PORT=5000
NODE_ENV=development

# --- Public URLs (served to the SPA via /js/config.js)
# Set both to the address browsers use to reach this server in production.
# MANGA_BASE_WEBSOCKET_URL is also baked into each new manga's thumbnail URL
# in manga_library.json (as in Flask), so changing the domain later means
# rewriting those records.
MANGA_BASE_URL=http://localhost:5000
MANGA_BASE_WEBSOCKET_URL=http://localhost:5000

# --- Storage (the Docker image sets the legacy Flask paths:
#     /downloaded, /vanmanga/eng_config/manga_library.json, /vanmanga/thumbnails)
DOWNLOAD_ROOT=./downloaded
LIBRARY_FILE=./eng_config/manga_library.json
THUMBNAILS_DIR=./thumbnails

# --- Download tuning
# Chapters downloaded in parallel within one manga
NUMBER_OF_WORKERS=2
# Concurrent image fetches within one chapter
IMAGE_CONCURRENCY=1
# Polite delay between image fetches per worker (ms); 0 disables
IMAGE_DELAY_MS=1000
# "X/Y images" progress log interval for long chapters (ms)
DOWNLOAD_PROGRESS_INTERVAL_MS=10000

# --- Search cache (lean add: POST /api/library with just manga_id)
# A candidate must be added within this long after the search (ms), else 410
SEARCH_CACHE_TTL_MS=1800000
SEARCH_CACHE_MAX_ENTRIES=500

# --- Kavita (optional). Enabled only when BASE_URL, EXPOSE_URL and
#     ADMIN_APIKEY are all set.
# URL the backend uses to reach Kavita (e.g. container network address)
KAVITA_BASE_URL=
# URL browsers use to reach Kavita (login links, series links)
KAVITA_EXPOSE_URL=
KAVITA_ADMIN_APIKEY=
KAVITA_LIB_ID=1

# --- FlareSolverr (optional; enables the Cloudflare monitor)
FLARESOLVERR_URL=

# --- Python scraper subprocess (wraps ../modules/* via ../scrape_cli.py)
# Interpreter with requirements-scraper.txt installed (e.g. a venv's python)
PYTHON_EXECUTABLE=python
PYTHON_CLI_SCRIPT=../scrape_cli.py
PYTHON_WORKING_DIR=..
PYTHON_TIMEOUT_MS=180000
